# Required — pick one of these two:
PAYER_KEYPAIR=/path/to/keypair.json
# PAYER_SECRET_KEY_JSON=[12,34,56,...]   # inline 64-byte secret-key array

# Required for production — use Helius/Triton/QuickNode, not public mainnet
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional — sensible defaults
X402_URL=https://x402.magpie.capital
TICK_INTERVAL_MS=600000             # 10 min
TARGET_LP_RATIO=0.7                 # 70% of assets in LP
MIN_IDLE_SOL=0.02                   # always keep this much SOL free
MIN_TX_SOL=0.01                     # skip rebalances below this size (dust)
MAX_DEPOSIT_SOL=1.0                 # single-tick deposit cap
HIGH_UTIL_PCT=0.92                  # refuse to withdraw above this util
REBALANCE_BAND=0.05                 # ±5% deadband around target
