# ── Magpie autonomous agent — environment ───────────────────────────────────
# Copy the values you need into Railway's "Variables" (or a local .env). Every
# default is the SAFE one; you opt INTO risk. Start in DRY-RUN, then flip LIVE=1.

# ── SAFETY: dry-run vs live ──────────────────────────────────────────────────
# Leave LIVE unset (or anything but 1) = DRY RUN: no funds move, real reads/decisions.
# LIVE=1 = real funds from the agent wallet.
# LIVE=1

# ── STRATEGY (what the agent does each cycle) ────────────────────────────────
# trade  = find/buy/sell memecoins for profit (mechanical SL/TP + brain).
# borrow = the in-vault loop: buy collateral → collateralize on Magpie → borrow → repay.
# both   = run both (borrow runs first so its repay reserve is set before trade sizes buys).
STRATEGY=trade                  # trade | borrow | both

# ── THE WALLET KEY (the agent IS the borrower; Magpie never sees this) ───────
# On Railway/containers, paste the key as a SECRET env var (bs58 OR a JSON byte array):
MAGPIE_PAYER_SECRET=
# …or, for LOCAL runs only, point at a keypair file instead:
# MAGPIE_PAYER_KEYPAIR=~/.config/solana/agent-wallet.json

# ── RPC + brain ──────────────────────────────────────────────────────────────
# Use a paid RPC (Helius/Triton) for a real always-on deployment.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The Claude brain (optional). With a key it researches + decides; without one it
# falls back to a safe deterministic picker.
ANTHROPIC_API_KEY=
# MAGPIE_BRAIN_MODEL=claude-sonnet-4-6

# ── WHAT IT TRADES (operator choice: memecoins + RWAs, active) ───────────────
PREFERRED_CATEGORY=any          # rwa | memecoin | any
OPEN_UNIVERSE=true              # true = pick live from Magpie's vetted catalog (no fixed allowlist)
USE_EXISTING_HOLDINGS=true      # true = collateralize tokens the wallet ALREADY holds (e.g. its BONK) before buying fresh
# MINT_ALLOWLIST=mint1,mint2    # set this to RESTRICT to specific mints (overrides OPEN_UNIVERSE)
MAX_TOKEN_RISK=60               # reject candidates above this Magpie risk score (0-100, lower = safer)

# ── RISK RAILS (safe defaults — raise only deliberately) ─────────────────────
TIER=standard                   # express(2d) | quick(3d) | standard(7d, most repay headroom)
MAX_OPEN_LOANS=1                # never juggle more than N deadlines at once
MAX_BUY_SOL=0                   # hard cap per buy in SOL; 0 = bounded only by the solvency reserve
MIN_COLLATERAL_SOL=1.0          # skip a borrow when collateral is worth less than this (no build-borrow fee
                                # on dust). MUST be < MAX_BUY_SOL minus slippage (when MAX_BUY_SOL>0 and
                                # USE_EXISTING_HOLDINGS=false) or the buy path can NEVER borrow — the agent
                                # warns loudly at boot if this deadlock is configured.
USE_V4_EXITS=true               # open on V4 + arm in-vault TP/SL (convenience, not the safety net)
MIN_OPERATING_SOL=0.02          # NEVER-STALE refuel: when a loan slot is free and free SOL drops below this,
REFUEL_TARGET_SOL=0.1           # sell just enough of a held memecoin to reach this much free SOL (tight top-up,
                                # not a basket dump) so the agent keeps cycling. MIN_OPERATING_SOL=0 disables.
ALLOW_RECURSIVE_REDEPLOY=false  # KEEP false — borrowed SOL is held as repay reserve, never re-leveraged
CYCLE_INTERVAL_MIN=30           # research cadence (minutes). Use 1-2 to preview a dry run quickly.

# ── NEVER-DEFAULT GUARDIAN (these keep loans from ever going overdue) ────────
# GUARDIAN_INTERVAL_MS=600000   # deadline sweep every 10 min
# REPAY_LEAD_FRACTION=0.5       # repay at the halfway point of the term…
# REPAY_LEAD_SECONDS_MIN=21600  # …and never later than 6h before due
# GAS_BUFFER_LAMPORTS=30000000  # keep 0.03 SOL for gas/rent

# ── PASSIVE MONITORING (DM every action) ─────────────────────────────────────
# Make a bot via @BotFather, get your numeric chat id from @userinfobot, then set:
AGENT_NOTIFY_TELEGRAM_TOKEN=
AGENT_NOTIFY_TELEGRAM_CHAT=

# ── PAYMENT SAFETY — anti-drain caps on x402 payments (set in production) ─────
# The payTo + amount in a 402 response are SERVER-SUPPLIED and untrusted: a
# compromised / MITM'd endpoint could demand a wallet-draining transfer. These
# caps bound what a hostile 402 can ever move — at most one capped fee, to a
# pinned recipient, never the wallet. Defaults are applied even if unset.
# X402_MAX_PAYMENT_LAMPORTS=20000000   # hard ceiling per x402 payment (default 0.02 SOL — above the dearest real Magpie endpoint at 0.01 SOL, far below anything worth draining)
# X402_ALLOWED_RECIPIENTS=             # comma-separated recipient allowlist. PIN to the Magpie x402 fee wallet — the `payTo`
#                                      #   at https://x402.magpie.capital/.well-known/x402.json — so a spoofed 402 to ANY
#                                      #   other address is refused. Empty = unpinned (only the amount cap applies). Recommended.
# JUPITER_BASE=https://lite-api.jup.ag # swap rail host; switch to a keyed Jupiter Ultra/Pro endpoint for production volume
