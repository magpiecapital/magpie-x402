# ─── Required: payer keypair (absolute path, or ~/ expanded) ──────────────
# A Solana keypair JSON file (the format `solana-keygen new` writes).
# The bot pays x402 fees (0.003 SOL per liquidation attempt) from this keypair
# and receives keeper rewards (in collateral token) at this address.
X402_PAYER_KEYPAIR=

# ─── Required: Solana RPC endpoint ────────────────────────────────────────
# Helius / QuickNode / Triton / public mainnet-beta.
# Helius recommended for production rate limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── Optional: Magpie x402 API base URL ───────────────────────────────────
# Defaults to the production x402 service at magpie.capital.
# Override to target a staging or local instance.
# X402_BASE_URL=https://x402.magpie.capital

# ─── Optional: Polling interval ───────────────────────────────────────────
# Milliseconds between liquidatable-loan polls. Default 8000 (8s).
# Free endpoint is cached for ~8s server-side, so <8000 is wasteful.
POLL_INTERVAL_MS=8000

# ─── Optional: Past-due threshold ─────────────────────────────────────────
# Skip loans that are not past due by at least this many seconds.
# Avoids racing other keepers on borderline cases. Default 0.
MIN_PAST_DUE_SEC=0

# ─── Optional: Profitability threshold ────────────────────────────────────
# Minimum keeper reward in lamports required to attempt a liquidation.
# If the keeper reward (keeper_reward_bps * seized_value) is below this,
# the bot skips the loan. Default 10000 lamports (~0.00001 SOL).
# Set to 0 to attempt any loan regardless of reward.
MIN_KEEPER_REWARD_LAMPORTS=10000

# ─── Optional: Estimated gas cost per tx (lamports) ───────────────────────
# Used in profit calculation: reward must exceed gas cost to be profitable.
# Default 5000 lamports (standard Solana tx fee).
GAS_COST_LAMPORTS=5000
