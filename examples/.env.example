# Copy to examples/.env before running local examples.
# The scripts also read process environment variables, so CI can inject these directly.

# Use http://localhost:8402 when `npm run dev` is running from the repo root.
MAGPIE_X402_BASE_URL=http://localhost:8402

# Demo wallet used for read-only wallet and credit-score requests.
MAGPIE_WALLET=9UuLsJ3jf8ViBNeRcwXD53re5G3ypgfKK3s2EiMMpump

# Collateral quote inputs for the borrowing agent.
# This defaults to wrapped SOL only so the pure-math simulator has a valid mint.
# Set MAGPIE_COLLATERAL_MINT to the live MAGPIE collateral mint for production demos.
MAGPIE_COLLATERAL_MINT=So11111111111111111111111111111111111111112
MAGPIE_COLLATERAL_AMOUNT_RAW=1000000000
MAGPIE_COLLATERAL_DECIMALS=9
MAGPIE_COLLATERAL_PRICE_USD=160
MAGPIE_SOL_PRICE_USD=160
MAGPIE_SOL_PRICE_24H_AGO_USD=150
MAGPIE_MIN_SOL_MOVE_PCT=5

# Liquidation monitor controls.
MAGPIE_LIQUIDATION_WITHIN_SECONDS=300
MAGPIE_LIQUIDATION_LIMIT=5
MAGPIE_LIQUIDATION_LOOPS=1

# Optional: after you send the on-chain payment requested by a 402 challenge,
# set the confirmed Solana signature here and re-run the paid example.
X402_PAYMENT_SIGNATURE=
