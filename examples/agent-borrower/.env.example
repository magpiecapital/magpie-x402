# =============================================================================
# Magpie Reference Borrowing Agent — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Agent signing key (provide ONE of the following):
# Option A: Base58-encoded secret key (preferred for Railway/VPS/Docker)
MAGPIE_PAYER_SECRET=
# Option B: Path to a solana-keygen JSON keypair file (local development)
# MAGPIE_PAYER_KEYPAIR=~/.config/solana/id.json

# Solana RPC URL. Use a paid endpoint (Helius/Triton) for production.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── OPTIONAL — Magpie x402 Service URLs ─────────────────────────────────────

# x402 payment service base URL (default: https://x402.magpie.capital)
# X402_BASE_URL=https://x402.magpie.capital

# Cosign endpoint host (default: https://magpie.capital)
# MAGPIE_SITE_URL=https://www.magpie.capital

# ── OPTIONAL — Agent Loop Configuration ─────────────────────────────────────

# How often the agent checks for borrowing opportunities (in seconds, default: 300)
# CHECK_INTERVAL=300

# How long to wait before retrying after an error (in seconds, default: 30)
# RETRY_DELAY_SECONDS=30

# ── OPTIONAL — Borrowing Strategy ───────────────────────────────────────────

# Maximum number of concurrent open loan positions (default: 3)
# MAX_POSITIONS=3

# Minimum 24h price change percentage to trigger a borrow (default: 5.0)
# Only borrow when a collateral token is up at least this much in 24h.
# MIN_PRICE_CHANGE_PCT=5.0

# Maximum 24h price change percentage to still allow a borrow (default: 50.0)
# Avoid chasing tokens that have already mooned.
# MAX_PRICE_CHANGE_PCT=50.0

# Maximum collateral value in SOL for a single position (default: 5.0)
# MAX_COLLATERAL_VALUE_SOL=5.0

# Minimum collateral value in SOL to bother borrowing against (default: 0.1)
# MIN_COLLATERAL_VALUE_SOL=0.1

# Borrow tier: "express" (2d), "quick" (3d), "standard" (7d) — default: "standard"
# BORROW_TIER=standard

# Prefer V4 program for in-vault exit support (default: true)
# USE_V4_EXITS=true

# Prevent borrowing against the same mint twice (diversity, default: true)
# ENFORCE_DIVERSITY=true

# ── OPTIONAL — Risk & Safety ────────────────────────────────────────────────

# Maximum x402 payment in lamports before refusal (default: 20000000 = 0.02 SOL)
# X402_MAX_PAYMENT_LAMPORTS=20000000

# Comma-separated allowlist of x402 payment recipient base58 addresses.
# Empty = any recipient allowed (subject to amount cap).
# X402_ALLOWED_RECIPIENTS=

# Mints to HARD-allow (comma-separated). If non-empty, ONLY these mints
# are considered as collateral. Empty = all eligible mints are candidates.
# MINT_ALLOWLIST=

# ── OPTIONAL — Logging ──────────────────────────────────────────────────────

# Log level: "info", "warn", "error", "debug" (default: "info")
# LOG_LEVEL=info
