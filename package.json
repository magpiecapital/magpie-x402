{
  "name": "magpie-x402",
  "version": "0.1.0",
  "description": "x402 payment-required API endpoints for the Magpie Capital protocol",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "x402",
    "magpie",
    "solana",
    "defi",
    "ai-agents",
    "payments",
    "api"
  ],
  "author": "Magpie Capital",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magpiecapital/magpie-x402.git"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@solana/web3.js": "^1.95.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "rpc-websockets": {
      "uuid": "^8.3.2"
    }
  }
}