# Magpie x402 — environment template
# Copy to .env locally; .env is gitignored. NEVER commit a populated copy.

# ─── Server ───────────────────────────────────────────────────
PORT=8402
NODE_ENV=development

# ─── Magpie payment recipient (Solana pubkey) ─────────────────
# All x402 payments route to this address. Set to your protocol's
# treasury wallet. Public-info-safe — this is on-chain anyway.
MAGPIE_PAY_TO=

# ─── Solana RPC ────────────────────────────────────────────────
# Helius / QuickNode / Triton / mainnet-beta. Helius recommended
# for production due to higher rate limits + parsed-tx API.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ─── Magpie protocol data source ──────────────────────────────
# Magpie's existing Postgres (Railway). Read-only credentials
# recommended — this service never writes to the protocol DB.
# Leave blank to run in dummy-data mode (useful for local dev).
MAGPIE_DB_READONLY_URL=

# ─── Rate limiting ────────────────────────────────────────────
# Per-IP request budgets. Defaults are conservative; tune up for
# production based on observed load.
RATE_LIMIT_PER_MIN=60
RATE_LIMIT_PER_HOUR=600

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" works for public APIs but
# is NOT recommended once you have authenticated callers.
CORS_ORIGINS=*

# ─── Price oracle (for x402 payment amount denominated in USD) ─
# Optional. If set, payment amounts get refreshed from on-chain
# SOL/USD price; otherwise we use the static prices in the
# endpoint definitions.
SOL_PRICE_REFRESH_INTERVAL_MS=60000
